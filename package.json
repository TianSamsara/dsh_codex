{
  "name": "dsh-plugin-codex-local-bridge",
  "version": "0.3.3",
  "description": "Codex 本地桥接与 Harness 模型连接面板",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": { ".": "./plugin/index.mjs", "./client": "./plugin/client.js", "./package.json": "./package.json", "./cordis.patch.yml": "./plugin/cordis.patch.yml", "./locale/*.json": "./plugin/locale/*.json" },
  "files": ["plugin", "bridge/*.mjs", "bridge/Start-Bridge.ps1", "Setup-Bridge.ps1", "Update-Bridge.ps1", "README.md", "CHANGELOG.md", "TROUBLESHOOTING.md"],
  "icon": "./plugin/icon.svg",
  "dsh": {
    "bundle": { "patch": "./plugin/cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-plugin-manager", "@deepseek-ai/dsh-client-ui-layout"] }
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5", "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2" },
  "scripts": { "start": "node bridge/server.mjs", "test": "node --test test/*.test.mjs plugin/test/*.test.mjs" },
  "engines": { "node": ">=20" }
}
